{
  "name": "vision-generator-mcp",
  "version": "0.1.0",
  "type": "module",
  "description": "Local MCP server for image and video generation via OpenAI-compatible providers",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rayss868/vision-generator-mcp.git"
  },
  "homepage": "https://github.com/rayss868/vision-generator-mcp",
  "bugs": {
    "url": "https://github.com/rayss868/vision-generator-mcp/issues"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "image-generation",
    "video-generation",
    "openai-compatible"
  ],
  "engines": {
    "node": ">=18"
  },
  "bin": {
    "vision-generator-mcp": "build/index.js"
  },
  "files": [
    "build",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc && node -e \"require('fs').chmodSync('build/index.js', '755')\"",
    "dev": "tsx src/index.ts",
    "check": "tsc --noEmit",
    "prepare": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.1",
    "axios": "^1.9.0",
    "form-data": "^4.0.0",
    "mime-types": "^2.1.35",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/mime-types": "^2.1.4",
    "@types/node": "^22.15.21",
    "tsx": "^4.19.2",
    "typescript": "^5.8.3"
  }
}
